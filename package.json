{
	"name": "@mat-henriqu/masks",
	"version": "1.0.3",
	"description": "Máscaras, parsers e validadores puros para dados brasileiros.",
	"keywords": [
		"masks",
		"mask",
		"brasil",
		"pt-br",
		"cpf",
		"cnpj",
		"cep",
		"telefone",
		"moeda",
		"brl",
		"data",
		"typescript"
	],
	"license": "MIT",
	"author": "Matheus Henrique",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mat-henriqu/masks.git"
	},
	"bugs": {
		"url": "https://github.com/mat-henriqu/masks/issues"
	},
	"homepage": "https://github.com/mat-henriqu/masks#readme",
	"main": "./dist/index.js",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"files": ["dist", "README.md", "LICENSE"],
	"sideEffects": false,
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsup",
		"build:watch": "tsup --watch",
		"check": "biome check .",
		"check:write": "biome check --write .",
		"ci:biome": "biome ci .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"lint": "biome lint .",
		"test": "vitest run --reporter verbose",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage --reporter verbose",
		"test:package": "node test/package-exports.mjs",
		"typecheck": "tsc --noEmit --pretty",
		"prepack": "npm run build"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "^4.1.10",
		"tsup": "^8.5.1",
		"typescript": "^5.9.3",
		"vitest": "^4.1.10"
	},
	"allowScripts": {
		"esbuild@0.28.1": true
	},
	"overrides": {
		"esbuild": "0.28.1"
	}
}
